rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superAdmin';
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAnyAdmin() {
      return isAdmin() || isSuperAdmin();
    }

    function isManageableUserRole() {
      return request.resource.data.role in ['user', 'admin'];
    }

    function keepsProtectedUserFields() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.isDisabled == resource.data.isDisabled;
    }

    function isSuperAdminUserManagementUpdate(userId) {
      return isSuperAdmin()
        && request.auth.uid != userId
        && isManageableUserRole();
    }

    // الأحاديث المنشورة: قراءة عامة، كتابة للمشرف العام فقط.
    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // التصنيفات: قراءة عامة، كتابة للمشرف العام فقط.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // أحاديث في انتظار المراجعة: مشرف المحتوى يُنشئ، المشرف العام يقرأ ويعدّل.
    match /pending_hadiths/{docId} {
      allow create: if isAnyAdmin()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.reviewStatus == 'pending';
      allow read: if isAnyAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // تصنيفات في انتظار المراجعة: نفس القواعد.
    match /pending_categories/{docId} {
      allow create: if isAnyAdmin()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.reviewStatus == 'pending';
      allow read: if isAnyAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ملفات تعريف المستخدمين.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());

      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.role == 'user';

      allow update: if isSuperAdminUserManagementUpdate(userId) ||
        (isSignedIn() && request.auth.uid == userId
          && keepsProtectedUserFields());

      allow delete: if isSuperAdmin();

      // تقدّم المستخدم (XP، السلسلة، الإنجازات) — كل مستخدم يكتب بياناته فقط.
      match /progress/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // الإشعارات المجمّعة: المشرف العام فقط.
    match /broadcasts/{broadcastId} {
      allow read, write: if isSuperAdmin();
    }

    // إعدادات التطبيق (مفتاح FCM): المشرف العام فقط.
    match /config/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
  }
}
